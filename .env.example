# ── FLASK ────────────────────────────────────────
FLASK_APP=main.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# ── BASE DE DATOS ─────────────────────────────────
DATABASE_URL=sqlite:///biblioteca.db

# ── JWT ───────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-here

# ── GEMINI API (Asistente personal) ───────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── SMTP / CORREO ─────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── SITIO ─────────────────────────────────────────
# URL pública: enlaces e imágenes de la plantilla de correos
PUBLIC_BASE_URL=https://sena.newonline.digital

# ── SMS (código 2FA por celular) ──────────────────
# console = solo imprime en logs (no envía). Cambia a 'twilio' para enviar de verdad.
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY_CODE=57
# Solo si SMS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=   # alternativa a TWILIO_FROM
